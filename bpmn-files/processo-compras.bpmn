<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   id="Definitions_Compras"
                   targetNamespace="http://bpmn.io/schema/bpmn">
  
  <bpmn:process id="Process_Compras" isExecutable="true" name="Processo de Compras">
    <bpmn:startEvent id="StartEvent_1" name="Solicitação de Compra">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:userTask id="UserTask_1" name="Preencher Formulário">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:serviceTask id="ServiceTask_1" name="Validar Orçamento">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:exclusiveGateway id="Gateway_1" name="Valor > R$ 1000?">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:userTask id="UserTask_2" name="Aprovação Gerencial">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:userTask>
    
    <bpmn:exclusiveGateway id="Gateway_2" name="Aprovado?">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:serviceTask id="ServiceTask_2" name="Processar Compra">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    
    <bpmn:endEvent id="EndEvent_1" name="Compra Realizada">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:endEvent id="EndEvent_2" name="Compra Rejeitada">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="UserTask_1" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="UserTask_1" targetRef="ServiceTask_1" />
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_1" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="SequenceFlow_4" name="Sim" sourceRef="Gateway_1" targetRef="UserTask_2" />
    <bpmn:sequenceFlow id="SequenceFlow_5" name="Não" sourceRef="Gateway_1" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="UserTask_2" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="SequenceFlow_7" name="Sim" sourceRef="Gateway_2" targetRef="ServiceTask_2" />
    <bpmn:sequenceFlow id="SequenceFlow_8" name="Não" sourceRef="Gateway_2" targetRef="EndEvent_2" />
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="ServiceTask_2" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Compras">
    <bpmndi:BPMNPlane id="BPMNPlane_Compras" bpmnElement="Process_Compras">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="80" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="58" y="143" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="UserTask_1_di" bpmnElement="UserTask_1">
        <dc:Bounds x="170" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="ServiceTask_1_di" bpmnElement="ServiceTask_1">
        <dc:Bounds x="320" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1">
        <dc:Bounds x="470" y="93" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="456" y="56" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="UserTask_2_di" bpmnElement="UserTask_2">
        <dc:Bounds x="570" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_2_di" bpmnElement="Gateway_2">
        <dc:Bounds x="720" y="93" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="725" y="56" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="ServiceTask_2_di" bpmnElement="ServiceTask_2">
        <dc:Bounds x="820" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="970" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="948" y="143" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_2_di" bpmnElement="EndEvent_2">
        <dc:Bounds x="970" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="950" y="243" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="SequenceFlow_1_di" bpmnElement="SequenceFlow_1">
        <di:waypoint x="116" y="118" />
        <di:waypoint x="170" y="118" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_2_di" bpmnElement="SequenceFlow_2">
        <di:waypoint x="270" y="118" />
        <di:waypoint x="320" y="118" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_3_di" bpmnElement="SequenceFlow_3">
        <di:waypoint x="420" y="118" />
        <di:waypoint x="470" y="118" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_4_di" bpmnElement="SequenceFlow_4">
        <di:waypoint x="520" y="118" />
        <di:waypoint x="570" y="118" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="537" y="100" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_5_di" bpmnElement="SequenceFlow_5">
        <di:waypoint x="495" y="143" />
        <di:waypoint x="495" y="218" />
        <di:waypoint x="745" y="218" />
        <di:waypoint x="745" y="143" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="612" y="200" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_6_di" bpmnElement="SequenceFlow_6">
        <di:waypoint x="670" y="118" />
        <di:waypoint x="720" y="118" />
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_7_di" bpmnElement="SequenceFlow_7">
        <di:waypoint x="770" y="118" />
        <di:waypoint x="820" y="118" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="787" y="100" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_8_di" bpmnElement="SequenceFlow_8">
        <di:waypoint x="745" y="143" />
        <di:waypoint x="745" y="218" />
        <di:waypoint x="970" y="218" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="752" y="178" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_9_di" bpmnElement="SequenceFlow_9">
        <di:waypoint x="920" y="118" />
        <di:waypoint x="970" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
