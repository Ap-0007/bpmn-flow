{
  "name": "@bpmn-flow/core",
  "version": "0.1.0",
  "description": "BPMN 2.0 parser and token-based execution engine. Isomorphic (Node and browser), zero runtime UI dependencies.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bpmn-moddle": "^10.0.0"
  }
}
